# Robinhood Chain RPC
ROBINHOOD_RPC_URL=https://robinhood.chain

# Wallet (private key for the agent's own wallet)
AGENT_PRIVATE_KEY=0x...

# OpenRouter API Key (optional, for LLM reasoning)
OPENROUTER_API_KEY=sk-or-v1-...

# Trading Parameters
INITIAL_CAPITAL=1000
MAX_POSITION_SIZE=0.2
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.1

# Evolution Parameters
POPULATION_SIZE=20
GENERATIONS=10
MUTATION_RATE=0.1
CROSSOVER_RATE=0.7

# Market Data Sources
YAHOO_FINANCE_ENABLED=true
BANKR_API_ENABLED=true
DEXSCREENER_ENABLED=true
